{
	"schemaVersion": 1,
	"id": "bobbamod",
	"version": "${version}",
	"name": "BobbaMod",
	"description": "Hypixel skyblock mod",
	"authors": [
		"redcars"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/bobbamod/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			{
				"value": "bobba.mod.BobbaMod",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "bobba.mod.client.BobbaModClient",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"bobbamod.mixins.json",
		{
			"config": "bobbamod.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	}
}